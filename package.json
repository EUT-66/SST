{
  "name": "mon-espace-sst",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulateurs": "vite --mode emulators",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "npx firebase-tools@15 emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulateurs": "npx firebase-tools@15 emulators:start --only auth,firestore,storage",
    "deploy": "npm run build && npx firebase-tools@15 deploy --only hosting,firestore",
    "deploy:storage": "npx firebase-tools@15 deploy --only storage"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.57.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
